# Public Supabase values used only for browser authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# REQUIRED in production. The full base URL of the backend API, including /api.
# Example: https://bly-api.onrender.com/api
VITE_API_URL=https://your-bly-api.onrender.com/api

# Optional. Base URL for auth email redirect links.
VITE_SITE_URL=https://your-bly-store.vercel.app
